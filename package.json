{
  "name": "technoimperiya",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "build": "tsc -b --pretty false && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5174 --strictPort",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env server/app.mjs",
    "dev:api": "node --env-file-if-exists=.env --watch server/app.mjs",
    "setup:admin": "node --env-file-if-exists=.env server/setup.mjs",
    "backup": "node --env-file-if-exists=.env server/backup.mjs",
    "test:api": "node --test server/store.test.mjs"
  },
  "dependencies": {
    "@fontsource/commissioner": "^5.3.0",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/russo-one": "^5.3.0",
    "express": "^5.3.0",
    "framer-motion": "14.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24.22.0 <25"
  }
}
