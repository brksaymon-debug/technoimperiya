# Copy to .env only on the server. Never commit/archive a real .env.
# Local preview uses Vite 5174 -> API 5175; use your real HTTPS origin in production.
SITE_ORIGIN=http://127.0.0.1:5174
PORT=5175
HOST=127.0.0.1
DATA_DIR=../technoimperiya-private/data
# For a trusted HTTPS reverse proxy only:
# TRUST_PROXY=1
# NODE_ENV=production
# Alternative to the protected admin-auth.json created by setup:admin:
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=
